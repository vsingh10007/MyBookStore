<%- include('includes/header') %>
<section class="page-top"><div class="wrap"><h1>Checkout</h1><p>Tell us where to send your books.</p></div></section>
<main class="wrap section-tight">
    <% if (error) { %><p class="message error"><%= error %></p><% } %>
    <div class="cart-layout">
        <form class="form" action="/checkout" method="post">
            <h2>Delivery details</h2>
            <div class="two">
                <label>Full name <input type="text" name="name" value="<%= v.name || '' %>" required autocomplete="name"></label>
                <label>Phone <input type="tel" name="phone" value="<%= v.phone || '' %>" required autocomplete="tel"></label>
            </div>
            <label>Address <textarea name="address" rows="3" required autocomplete="street-address"><%= v.address || '' %></textarea></label>
            <div class="two">
                <label>City <input type="text" name="city" value="<%= v.city || '' %>" required></label>
                <label>PIN / ZIP code <input type="text" name="pincode" value="<%= v.pincode || '' %>" required></label>
            </div>
            <p class="paybox">💵 <strong>Cash on delivery</strong> <span>Pay in cash when your order arrives.</span></p>
            <button class="btn btn-buy btn-big btn-block">Place order · <%= money(cart.total) %></button>
        </form>
        <aside class="summary">
            <h2>Your items</h2>
            <% cart.items.forEach((i) => { %>
                <div class="mini">
                    <img src="<%= imgSrc(i.book.img) %>" alt="" onerror="this.onerror=null;this.src='/default-book-cover.svg'">
                    <div><strong><%= i.book.title %></strong><small><%= i.qty %> × <%= money(i.book.price) %></small></div>
                    <span><%= money(i.line) %></span>
                </div>
            <% }) %>
            <p class="line total"><span>Total</span><strong><%= money(cart.total) %></strong></p>
            <a class="btn btn-line btn-block" href="/cart">Edit cart</a>
        </aside>
    </div>
</main>
<%- include('includes/footer') %>
