<%- include('../includes/header') %>
<section class="page-top"><div class="wrap"><h1><%= isEdit ? 'Edit book' : 'Add new book' %></h1><p><%= isEdit ? 'Change any detail and press Save.' : 'Fill in the details of the new book.' %></p></div></section>
<main class="wrap section-tight">
    <%- include('menu', { tab: isEdit ? 'books' : 'new' }) %>
    <% if (error) { %><p class="message error"><%= error %></p><% } %>

    <form class="form book-form" action="<%= isEdit ? '/admin/books/' + book._id : '/admin/books' %>" method="post" enctype="multipart/form-data">
        <div class="form-cols">
            <div>
                <label>Book title <input type="text" name="title" value="<%= book.title || '' %>" maxlength="150" required></label>
                <label>Author <input type="text" name="author" value="<%= book.author || '' %>" maxlength="100" required></label>
                <div class="two">
                    <label>Price (<%= money(0).replace('0', '') %>) <input type="number" name="price" min="0" step="0.01" value="<%= book.price === undefined || book.price === null ? '' : book.price %>" required></label>
                    <label>Category <input type="text" name="category" list="cats" value="<%= book.category || '' %>" maxlength="50" placeholder="e.g. Fantasy" required></label>
                </div>
                <datalist id="cats"><% (typeof cats !== 'undefined' ? cats : []).forEach((c) => { %><option value="<%= c %>"><% }) %></datalist>
                <label>Description <textarea name="description" rows="6" maxlength="1500" placeholder="A few lines about the book"><%= book.description || '' %></textarea></label>
                <label class="check"><input type="checkbox" name="featured" <%= book.featured ? 'checked' : '' %>> ⭐ Show this book in “Featured” on the home page</label>
            </div>
            <div>
                <label>Cover picture <small>(JPG, PNG or WEBP, max 3 MB)</small></label>
                <div class="preview"><img id="preview" src="<%= imgSrc(book.img) %>" alt="Cover preview" onerror="this.onerror=null;this.src='/default-book-cover.svg'"></div>
                <input type="file" name="img" accept="image/*" onchange="var f=this.files[0]; if(f) document.getElementById('preview').src=URL.createObjectURL(f)">
                <small><%= isEdit ? 'Leave empty to keep the current picture.' : 'If you skip this, a default cover is used.' %></small>
            </div>
        </div>
        <div class="form-actions">
            <button class="btn btn-dark btn-big"><%= isEdit ? 'Save changes' : 'Add book' %></button>
            <a class="btn btn-line btn-big" href="/admin">Cancel</a>
        </div>
    </form>
</main>
<%- include('../includes/footer') %>
